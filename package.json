{
  "name": "ghartak-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GharTak - Safety-first Android app and Web companion",
  "workspaces": [
    "backend",
    "client"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:client\"",
    "test": "npm --prefix backend run test",
    "build": "npm --prefix backend run build && npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
